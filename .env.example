
MONGO_URI=mongodb://localhost:xxxxx
MONGO_DB_NAME=MindSync 

# Get a free/paid key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Where ChromaDB will persist its vector index on disk
CHROMA_PERSIST_DIR=./chroma_store

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Anyone with this value can forge valid login tokens — never commit the real one.
JWT_SECRET_KEY=replace_with_a_random_64_char_hex_string

# Required as "setup_key" when calling POST /auth/admin/register.
# Prevents anyone from self-registering as an admin.
ADMIN_SETUP_KEY=choose_your_own_admin_setup_passphrase
