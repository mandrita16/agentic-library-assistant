# ============================================================
# MindSync — Environment Configuration Example
# ============================================================

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=library_assistant


# ============================================================
# Groq / LLM
# ============================================================

# Get your API key from:
# https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Groq model used by MindSync
GROQ_MODEL=your_groq_model_here


# ============================================================
# ChromaDB
# ============================================================

# Where ChromaDB persists its vector index on disk
CHROMA_PERSIST_DIR=./chroma_store


# ============================================================
# JWT Authentication
# ============================================================

# Use a long random secret in the actual .env file
JWT_SECRET=your_jwt_secret_here

# JWT expiration time in minutes
JWT_EXPIRE_MINUTES=60